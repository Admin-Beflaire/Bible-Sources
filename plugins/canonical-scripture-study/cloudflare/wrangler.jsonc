{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canonical-scripture-study",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./generated/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "keep_vars": true,
  "previews": {
    "vars": {
      "PREVIEW_DELIVERY": "true",
      "PREVIEW_DEBUG": "true",
      "TEAM_DOMAIN": "https://plain-violet-0e50.cloudflareaccess.com",
      "POLICY_AUD": "f717575db1e37aec81acbf7f39ca0e5db3eb8fc04de5200d0894359394900314"
    },
    "ratelimits": [
      {
        "name": "MCP_RATE_LIMITER",
        "namespace_id": "73001901",
        "simple": {
          "limit": 120,
          "period": 60
        }
      }
    ],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "redact_query_string": true,
      "logs": {
        "enabled": true,
        "invocation_logs": true
      }
    }
  },
  "preview_urls": true,
  "minify": true,
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "73001902",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
